# Maintainer: Adrian <adrian@mxlinux.org>

# PKGBUILD for building on the Open Build Service.
#
# OBS builds offline from the Debian source archive in debs/. Regenerate the
# archive when CMake install rules change, and keep pkgver in sync with the
# changelog so makepkg selects the matching archive.

pkgname=quick-system-info-gui
pkgver=26.11
pkgrel=1
pkgdesc="A utility to show quick-system-info (inxi, etc...) in a gui"
arch=('x86_64' 'i686')
url="https://github.com/MX-Linux/quick-system-info-gui"
license=('GPL3')
depends=('qt6-base' 'libarchive' 'polkit' 'inxi' 'perl' 'gzip')
makedepends=('cmake' 'ninja' 'qt6-tools')
source=("${pkgname}_${pkgver}.tar.xz")
sha256sums=('SKIP')

# Debian source archives and GitHub tag archives can use different root names.
_enter_source() {
    local projects=("$srcdir"/*/CMakeLists.txt)
    if (( ${#projects[@]} != 1 )) || [[ ! -f ${projects[0]} ]]; then
        printf 'Expected one extracted CMake project in %s\n' "$srcdir" >&2
        return 1
    fi
    cd -- "${projects[0]%/CMakeLists.txt}"
}

build() {
    _enter_source || return 1

    rm -rf build

    cmake -G Ninja \
        -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
        -DPROJECT_VERSION_OVERRIDE="${pkgver}"

    cmake --build build --parallel
}

package() {
    _enter_source || return 1

    DESTDIR="$pkgdir" cmake --install build

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
