# A bare tar-ignore keeps dpkg-source's default excludes (.git, .gitignore, ...);
# giving only patterns would replace them and pull the whole git history in.
tar-ignore
tar-ignore = ".*"
tar-ignore = "*.autosave"
tar-ignore = "CMakeLists.txt.user"
tar-ignore = "CMakeUserPresets.json"
tar-ignore = "_build_"

# CMake build trees and locally built Arch packages.
tar-ignore = build
tar-ignore = build-*

# Source and binary packages produced by earlier releases.
tar-ignore = debs
